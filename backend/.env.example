# ==============================================================================
# RAS-RAG ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application
APP_NAME=RAS-RAG
APP_ENV=development
DEBUG=True
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security & JWT
SECRET_KEY=change-this-to-a-super-secure-random-32-byte-hex-string-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=sqlite:///./data/ras_rag.db

# Storage
UPLOAD_DIR=./data/uploads
CHROMA_PERSIST_DIR=./data/chroma_db
MAX_FILE_SIZE_MB=15

# Local AI & RAG Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
FALLBACK_LLM_ENABLED=True

# Risk Engine Thresholds & Weights
RISK_WEIGHT_QUERY=0.45
RISK_WEIGHT_SESSION=0.35
RISK_WEIGHT_DOC_SENSITIVITY=0.20

THRESHOLD_ALLOW=30.0
THRESHOLD_RESTRICT=60.0
THRESHOLD_VERIFY=80.0
# Score >= 80 is BLOCK

# Default Admin Seed Credentials (for initial setup)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@rasrag.local
DEFAULT_ADMIN_PASSWORD=AdminSecure@2026
DEFAULT_USER_USERNAME=analyst
DEFAULT_USER_EMAIL=analyst@rasrag.local
DEFAULT_USER_PASSWORD=UserSecure@2026
